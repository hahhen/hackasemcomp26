# Existing local Ollama preset. Change FROM to use another installed model.
#
#   ollama pull qwen3:8b
#   ollama create ifood-agent -f Modelfile.ollama
#
# Then set ENVIRONMENT=local and OLLAMA_MODEL=ifood-agent in .env.

FROM qwen3:8b

# Room for chat history and Mesa's six tools. Raw MCP schemas stay in Python.
PARAMETER num_ctx 16384

# Deterministic tool selection, matching make_client(temperature=0).
PARAMETER temperature 0
