# Copy this file to `.env` and fill in your values.
#
# Any OpenAI-compatible provider works here. Everything is read from these
# variables, so switching providers is a one-line edit.

# --- Environment switch ------------------------------------------------------
# local  = Ollama (free, no key, all 23 tools fit; ~30-90s per turn)
# remote = cheapest paid Zen model (fast, reliable; ~2-5 cents per flow)
ENVIRONMENT=remote

# --- Remote (OpenCode Zen) ---------------------------------------------------
# Get a key: https://opencode.ai/zen  (uses your OpenCode credits)
OPENCODE_ZEN_API_KEY=

# --- Local (Ollama) ----------------------------------------------------------
# Build once:
#   ollama pull qwen3:8b
#   ollama create ifood-agent -f Modelfile.ollama
# Modelfile.ollama sets num_ctx=16384, which is required: Ollama's 4096 default
# would silently truncate the 10.5k tokens of tool schemas. No key needed.

# --- Retries and provider fallbacks -----------------------------------------
# Per-request retries with exponential backoff + jitter (OpenAI SDK).
LLM_MAX_RETRIES=5
# Generous, because a local model has to be paged into VRAM on the first call.
LLM_TIMEOUT=300
# Providers tried in order once the primary has exhausted its retries.
# Each needs its own key in the matching *_API_KEY variable below.
# Options: ollama, groq, gemini, cerebras, openrouter, mistral, zen, openai
# (`ollama` is local and needs no key.)
#
# Left empty on purpose: with all 23 tools bound (10,508 tokens) no free cloud
# tier can accept the request, so a fallback would fail too. Add one only after
# restricting MCP_TOOLS below.
LLM_FALLBACKS=
GROQ_API_KEY=
GEMINI_API_KEY=
# Audio transcription, independent of the main chat model.
GEMINI_AUDIO_MODEL=gemini-2.5-flash-lite
CEREBRAS_API_KEY=
# Per-provider model override (optional), e.g. GEMINI_MODEL=gemini-2.5-pro
# GEMINI_MODEL=
# CEREBRAS_MODEL=
#
# Free-tier budgets, measured during development -- plan around them:
#   Groq   : 8,000 tokens/minute. Too small for the full iFood tool set.
#   Gemini : 20 requests PER DAY on gemini-2.5-flash. When exhausted it replies
#            "Quota exceeded ... limit: 20 ... Please retry in 1h57m".
# A fallback only rescues you while it still has quota left.

# --- iFood MCP (sudowin-semcomp) --------------------------------------------
# The agent loads these tools on start unless MCP_ENABLED=false.
# Client id/secret come from setup-sudowin-mcp.mjs.
MCP_ENABLED=true
MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
MCP_REDIRECT_URI=http://localhost:8080/agent
MCP_AUTHORIZE_ENDPOINT=https://id.ifood.com.br/authorize
MCP_TOKEN_ENDPOINT=https://id.ifood.com.br/token
MCP_TOKEN_CACHE=.mcp-token.json
# Optional: a pre-provisioned bearer token skips the browser sign-in entirely.
MCP_BEARER_TOKEN=
# MCP_SCOPE=
# MCP_OAUTH_TIMEOUT=300
#
# Tool schemas are sent on EVERY model call. Measured cost of the iFood schema:
#    23 tools (all)         = 10,508 tokens  -> over Groq's free 8k TPM (HTTP 413)
#    19 tools (minus 4 big) =  7,258 tokens
#    12 tools (order flow)  =  6,207 tokens  <- verified working on Groq free
#     9 tools (minimal)     =  4,999 tokens
# Per-tool detail: IFOOD-MCP-TOOLS.md
# Empty = all tools. Choose a subset that fits your provider's limit, or pay for
# a higher tier. See MCP-FEEDBACK.md for the full analysis.
# MCP_TOOLS=listAddresses,getUser,searchOffers,getItem,getMerchant,createCart,addItemToCart,updateCartItem,getCart,setCartDelivery,setCartPayment,submitOrder
MCP_TOOLS=
MCP_EXCLUDE_TOOLS=

# --- iFood Mesa (FastAPI backend) -------------------------------------------
# mock = in-memory iFood, no account, no real orders (default, safe for the UI).
# live = the real sudowin-semcomp MCP (needs the OAuth sign-in above).
MESA_MODE=live
# submitOrder places a REAL order with REAL money. In live mode it is skipped
# (the order is simulated) unless this is true.
MESA_SUBMIT_ENABLED=false
# Send the order by itself when the last person pays. Closing the cart is the
# host's explicit consent, so "todos pagaram" is the trigger. false = the host
# still presses "Enviar pedido".
MESA_AUTO_SUBMIT=true
# The chat agent (the model that reads "a Bia é vegetariana" and fills the table).
# false = no model call at all: messages are recorded and the wish is taken from
# the words themselves. Works fully offline; the test suite runs this way.
MESA_CHAT_LLM=true
# Turn each wish into search terms with the model (one call per search).
# false = keywords only. The chat agent already writes clean text, so the
# automatic re-search stays off the model by default - it is much faster.
MESA_RECOMMEND_LLM=false
# Default for intent extraction when a caller does not say (see MESA_RECOMMEND_LLM).
MESA_USE_LLM=true
# Seconds to wait for the LLM before falling back to the heuristic.
MESA_LLM_TIMEOUT=90
# Hard ceiling on one chat turn. On timeout the turn ends with a message
# instead of leaving the chat hanging.
MESA_CHAT_TIMEOUT=90
# Let the LLM rewrite the final summary message (slower on a local model).
MESA_LLM_NARRATE=false
# Keep tables across server restarts (optional).
MESA_PERSIST=sessions.json
# Structured graph/tool traces, rotated locally (5 MB, 3 backups).
MESA_OBSERVABILITY=true
MESA_TRACE_FILE=logs/observability.jsonl
# MESA_CORS_ORIGINS=http://localhost:5173

# --- Other providers (via LLM_FALLBACKS) -------------------------------------
#
# ENVIRONMENT above covers local (Ollama) and remote (Zen). To use a different
# provider as the primary, edit PRESETS in src/agent/providers.py. To add a
# fallback, list it in LLM_FALLBACKS with its key below.
#
# OpenCode Zen (paid models only -- "-free" ids are blocked outside OpenCode).
# Key: https://opencode.ai/zen
#   Cheaper Zen options: glm-5.3-flash (default), qwen3.8-flash, minimax-m3
#
# Google Gemini (free Flash models, key: https://aistudio.google.com/apikey)
# LLM_API_KEY=<google-key>
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL_NAME=gemini-2.5-flash
#
# Cerebras (free tier, key: https://cloud.cerebras.ai)
# LLM_API_KEY=<cerebras-key>
# LLM_BASE_URL=https://api.cerebras.ai/v1
# MODEL_NAME=llama-3.3-70b
#
# OpenAI (paid, key: https://platform.openai.com/api-keys)
# LLM_API_KEY=<openai-key>
# LLM_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
