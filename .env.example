# Copy to .env in the repository root. Existing .env values take precedence
# over PowerShell environment variables when the backend starts.

# TEXT MODEL: local = Ollama; remote = OpenCode Zen. Independent of MESA_MODE.
ENVIRONMENT=remote
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=glm-5.3-flash
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=ifood-agent
LLM_MAX_RETRIES=5
LLM_TIMEOUT=300

# AUDIO ONLY: Gemini transcribes microphone input before normal text chat.
# Leave the key empty if you will only type. Pick a model available to your key.
GEMINI_API_KEY=
GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite

# IFOOD DATA: mock = local catalog; live = real iFood MCP with OAuth.
# Mock does not disable external text-model or audio calls.
MESA_MODE=mock
MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
MCP_REDIRECT_URI=http://localhost:8080/agent
MCP_AUTHORIZE_ENDPOINT=https://id.ifood.com.br/authorize
MCP_TOKEN_ENDPOINT=https://id.ifood.com.br/token
MCP_TOKEN_CACHE=.mcp-token.json
# Optional pre-provisioned bearer token; skips OAuth and cannot auto-refresh.
MCP_BEARER_TOKEN=
# MCP_SCOPE=
# MCP_OAUTH_TIMEOUT=300
MCP_MAX_CONCURRENT_CALLS=4

# CHECKOUT: live mode still creates/updates real carts with submission disabled.
# Real submitOrder is enabled only when this is true.
MESA_SUBMIT_ENABLED=false
# Start checkout automatically after all payment confirmations.
MESA_AUTO_SUBMIT=true

# LANGUAGE: chat uses the configured model; discovery normally uses keywords.
MESA_CHAT_LLM=true
MESA_RECOMMEND_LLM=false
MESA_USE_LLM=true
MESA_LLM_TIMEOUT=90
MESA_CHAT_TIMEOUT=90

# LOCAL STATE AND STRUCTURED TRACES
MESA_PERSIST=sessions.json
MESA_OBSERVABILITY=true
MESA_TRACE_FILE=logs/observability.jsonl
# MESA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
